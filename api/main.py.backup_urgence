"""
API DropoutIA -- expose les 2 modeles :
- modele_decrochage.pkl pour la probabilite de decrochage
- modele_risque.pkl pour le niveau de risque 1/2/3/4
"""

import sys
import os
import io

import pandas as pd
import joblib
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import JSONResponse

sys.path.append(os.path.abspath("../src"))
import nettoyage

MODELE_DECROCHAGE = joblib.load("../models/modele_decrochage.pkl")
MODELE_RISQUE = joblib.load("../models/modele_risque.pkl")

COLONNES_MODELE_DECROCHAGE = [
    "id_Genre", "nefstat", "NbrAbsence", "NbrRedoublement",
    "MoyenneNotes", "cd_com", "NbrAbsence_manquant", "age"
]
COLONNES_MODELE_RISQUE = [
    "id_Genre", "Nefstat", "NbrAbsence", "NbrRedoublement",
    "MoyenneNotes", "CD_REG", "CD_PROV", "CD_MIL",
    "NbrAbsence_manquant", "age"
]

app = FastAPI(title="DropoutIA API")


def preparer_fichier(df_brut: pd.DataFrame) -> pd.DataFrame:
    df = df_brut.copy()
    df = nettoyage.gerer_absences_manquantes(df, colonne="NbrAbsence")
    df = nettoyage.calculer_age(df, colonne_date="dateNaisEleve")
    df = nettoyage.encoder_categorielles(df, ["nefstat"])
    if "nefstat" in df.columns and "Nefstat" not in df.columns:
        df["Nefstat"] = df["nefstat"]
    return df


def appliquer_regle_coherence(niveau_risque: int, probabilite_decrochage: float) -> int:
    """
    Le niveau de risque vient du modele risque.
    La probabilite vient du modele decrochage.

    Regle minimale de coherence : si le modele decrochage donne plus de 50%
    de risque de decrochage, on evite d'afficher "Tres faible".
    """
    if probabilite_decrochage > 0.5 and niveau_risque == 1:
        return 2
    return niveau_risque


LIBELLES_NIVEAU = {1: "Tres faible", 2: "Faible", 3: "Modere", 4: "Severe"}

RECOMMANDATIONS = {
    1: "Aucune action requise. Suivi de routine.",
    2: "Suivi recommande lors du prochain conseil de classe.",
    3: "Entretien conseille avec l'eleve dans les prochaines semaines.",
    4: "Intervention prioritaire : entretien avec l'eleve et sa famille recommande dans les meilleurs delais.",
}


@app.post("/predict")
async def predict(fichier: UploadFile = File(...)):
    if not fichier.filename.endswith((".xlsx", ".xls")):
        raise HTTPException(status_code=400, detail="Le fichier doit etre un Excel (.xlsx)")

    contenu = await fichier.read()
    try:
        df_brut = pd.read_excel(io.BytesIO(contenu))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Impossible de lire le fichier Excel : {e}")

    df_pret = preparer_fichier(df_brut)

    colonnes_attendues = COLONNES_MODELE_DECROCHAGE + COLONNES_MODELE_RISQUE
    colonnes_manquantes = set(colonnes_attendues) - set(df_pret.columns)
    if colonnes_manquantes:
        raise HTTPException(
            status_code=400,
            detail=f"Colonnes manquantes dans le fichier envoye : {colonnes_manquantes}"
        )

    X_decrochage = df_pret[COLONNES_MODELE_DECROCHAGE]
    X_risque = df_pret[COLONNES_MODELE_RISQUE]

    proba_decrochage = MODELE_DECROCHAGE.predict_proba(X_decrochage)[:, 1]
    niveau_risque_modele = MODELE_RISQUE.predict(X_risque)

    resultats = []
    for i in range(len(df_pret)):
        proba_pct = round(float(proba_decrochage[i]) * 100, 1)
        niveau_modele = int(niveau_risque_modele[i])
        niveau = appliquer_regle_coherence(niveau_modele, float(proba_decrochage[i]))
        resultats.append({
            "codeEleve": str(df_brut.iloc[i].get("codeEleve", f"eleve_{i}")),
            "niveau_risque_predit": niveau,
            "niveau_risque_modele": niveau_modele,
            "niveau_risque_libelle": LIBELLES_NIVEAU[niveau],
            "probabilite_decrochage_pct": proba_pct,
            "regle_coherence_appliquee": niveau != niveau_modele,
            "recommandation": RECOMMANDATIONS[niveau],
        })

    return JSONResponse(content={"nombre_eleves": len(resultats), "resultats": resultats})


@app.get("/")
def accueil():
    return {"message": "API DropoutIA active avec les 2 modeles. Voir /docs."}
